#!/usr/bin/env bash
# Basecamp: offline knowledge box with local AI for macOS.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN="$ROOT/.run"
CONFIG="$ROOT/config.json"
PLIST="$HOME/Library/LaunchAgents/app.basecamp.server.plist"
mkdir -p "$RUN"

# Python and Ollama: bundled ones (USB stick or stick install) win, else the dev setup (.venv, Homebrew)
RUNTIME="$(cd "$ROOT/.." && pwd)/runtime"
if [[ -n "${BASECAMP_PYTHON:-}" ]]; then PY="$BASECAMP_PYTHON"
elif [[ -x "$RUNTIME/python/bin/python3" ]]; then PY="$RUNTIME/python/bin/python3"
else PY="$ROOT/.venv/bin/python"; fi
if [[ -n "${BASECAMP_OLLAMA_BIN:-}" ]]; then OLLAMA="$BASECAMP_OLLAMA_BIN"
elif [[ -x "$RUNTIME/ollama/ollama" ]]; then OLLAMA="$RUNTIME/ollama/ollama"
else OLLAMA="$(command -v ollama || true)"; fi

say()  { printf '\033[1;32m▸\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

cfg() {  # cfg KEY DEFAULT
  if [[ -f "$CONFIG" ]]; then
    "$PY" -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], sys.argv[3]))' "$CONFIG" "$1" "$2"
  else
    echo "$2"
  fi
}

port() { echo "${BASECAMP_PORT:-$(cfg port 4774)}"; }
url()  { echo "http://127.0.0.1:$(port)"; }
OLLAMA_URL="${BASECAMP_OLLAMA_URL:-$( [[ -x "$PY" ]] && cfg ollama_url http://127.0.0.1:11434 || echo http://127.0.0.1:11434)}"
export OLLAMA_HOST="${OLLAMA_URL#http://}"  # the ollama CLI talks to the same server
alive() { [[ -f "$RUN/$1.pid" ]] && kill -0 "$(cat "$RUN/$1.pid")" 2>/dev/null; }
server_up() { curl -fsS -m 2 "$(url)/api/status" >/dev/null 2>&1; }
ollama_up() { curl -fsS -m 2 "$OLLAMA_URL/api/version" >/dev/null 2>&1; }

api_post() {  # api_post ROUTE JSON
  server_up || die "Basecamp läuft nicht. Erst: ./basecamp start"
  curl -fsS -X POST -H 'Content-Type: application/json' -d "$2" "$(url)/api/$1"
  echo
}

need_venv() { [[ -x "$PY" ]] || die "Noch nicht eingerichtet. Erst: ./basecamp setup"; }
need_ollama() { [[ -n "$OLLAMA" && -x "$OLLAMA" ]] || die "Ollama fehlt. Erst: ./basecamp setup"; }

# ------------------------------------------------------------------ setup

cmd_setup() {
  local data=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --data) data="$2"; shift 2 ;;
      *) die "Unbekannte Option: $1" ;;
    esac
  done

  [[ "$(uname -s)" == "Darwin" ]] || warn "Gebaut für macOS. Auf anderen Systemen ohne Gewähr."
  [[ "$(uname -m)" == "arm64" ]] || warn "Intel-Mac erkannt. KI läuft dort sehr langsam, Wissen funktioniert normal."

  if [[ "$PY" == "$ROOT/.venv/bin/python" ]]; then
    command -v python3 >/dev/null || die "python3 fehlt. Installiere es mit: brew install python"
    python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' || die "Python 3.9 oder neuer nötig."
    if [[ ! -x "$PY" ]]; then
      say "Lege Python-Umgebung an"
      python3 -m venv "$ROOT/.venv"
    fi
    say "Installiere libzim"
    "$PY" -m pip install -q --upgrade pip
    "$PY" -m pip install -q -r "$ROOT/server/requirements.txt"
  fi

  if [[ -z "$OLLAMA" ]]; then
    if command -v brew >/dev/null; then
      say "Installiere Ollama (Homebrew)"
      brew install ollama
    else
      warn "Ollama fehlt. Lade es hier: https://ollama.com/download (danach ./basecamp setup nochmal)"
    fi
  fi
  if ! command -v pmtiles >/dev/null; then
    if command -v brew >/dev/null; then
      say "Installiere pmtiles (für Offline-Karten)"
      brew install pmtiles
    else
      warn "pmtiles fehlt, Karten-Download geht dann nicht. Mit Homebrew: brew install pmtiles"
    fi
  fi

  if [[ ! -f "$CONFIG" ]]; then
    "$PY" -I -c 'import json,sys; json.dump({"data_dir": sys.argv[2], "port": 4774}, open(sys.argv[1], "w"), indent=2)' \
      "$CONFIG" "${data:-$ROOT/data}"
  elif [[ -n "$data" ]]; then
    "$PY" -I -c 'import json,sys; c=json.load(open(sys.argv[1])); c["data_dir"]=sys.argv[2]; json.dump(c, open(sys.argv[1], "w"), indent=2)' "$CONFIG" "$data"
  fi

  local data_dir; data_dir="$(cfg data_dir "$ROOT/data")"
  mkdir -p "$data_dir/zim" "$data_dir/maps" "$data_dir/library" "$data_dir/code"
  # Content can be re-downloaded any time, so keep it out of Time Machine.
  tmutil addexclusion "$data_dir/zim" "$data_dir/maps" 2>/dev/null && say "Inhalte und Karten von Time Machine ausgenommen" || true

  echo
  "$PY" "$ROOT/server/app.py" --info
  echo
  offer_mcp
  say "Fertig. Nächste Schritte:"
  echo "   ./basecamp start            # startet alles und öffnet den Browser"
  echo "   ./basecamp models           # lädt das empfohlene KI-Modell"
  echo "   ./basecamp download S|M|L|X # lädt ein Inhaltspaket (oder im Browser unter Verwalten)"
}

# ------------------------------------------------------------------ run

start_ollama() {
  ollama_up && return 0
  [[ -n "$OLLAMA" && -x "$OLLAMA" ]] || { warn "Ollama nicht installiert. KI ist aus, Wissen geht trotzdem."; return 0; }
  say "Starte Ollama"
  local models; models="${BASECAMP_OLLAMA_MODELS:-$(cfg ollama_models_dir "")}"
  [[ -n "$models" ]] && mkdir -p "$models"
  env OLLAMA_FLASH_ATTENTION=1 OLLAMA_KV_CACHE_TYPE=q8_0 OLLAMA_KEEP_ALIVE=30m \
    ${models:+"OLLAMA_MODELS=$models"} \
    nohup "$OLLAMA" serve >>"$RUN/ollama.log" 2>&1 &
  echo $! >"$RUN/ollama.pid"
  for _ in $(seq 1 40); do ollama_up && return 0; sleep 0.25; done
  warn "Ollama antwortet nicht. Log: $RUN/ollama.log"
}

cmd_start() {
  need_venv
  local args=() open=1
  for a in "$@"; do
    case "$a" in
      --lan) args+=(--lan) ;;
      --no-open) open=0 ;;
      *) die "Unbekannte Option: $a" ;;
    esac
  done
  start_ollama
  if server_up; then
    say "Basecamp läuft schon: $(url)"
  else
    if lsof -nP -iTCP:"$(port)" -sTCP:LISTEN >/dev/null 2>&1; then
      die "Port $(port) ist schon belegt ($(lsof -nP -iTCP:"$(port)" -sTCP:LISTEN | awk 'NR==2{print $1}')). Anderen Port in config.json eintragen."
    fi
    say "Starte Basecamp"
    nohup "$PY" "$ROOT/server/app.py" ${args[@]+"${args[@]}"} >>"$RUN/server.log" 2>&1 &
    echo $! >"$RUN/server.pid"
    for _ in $(seq 1 60); do server_up && break; sleep 0.25; done
    server_up || die "Server startet nicht. Log: $RUN/server.log"
    say "Basecamp läuft: $(url)"
  fi
  if [[ " ${args[*]-} " == *" --lan "* ]]; then
    local ip; ip="$(ipconfig getifaddr en0 2>/dev/null || true)"
    [[ -n "$ip" ]] && say "Im WLAN: http://$ip:$(port)"
  fi
  [[ $open == 1 && -z "${BASECAMP_NO_OPEN:-}" ]] && open "$(url)"
  return 0
}

cmd_run() {  # foreground, used by launchd
  need_venv
  start_ollama
  echo $$ >"$RUN/server.pid"  # exec keeps the pid
  exec "$PY" "$ROOT/server/app.py" "$@"
}

cmd_stop() {
  local pid
  pid="$(lsof -tiTCP:"$(port)" -sTCP:LISTEN 2>/dev/null | head -1 || true)"
  if alive server; then
    kill "$(cat "$RUN/server.pid")" && say "Basecamp gestoppt"
  elif [[ -n "$pid" ]] && server_up; then
    kill "$pid" && say "Basecamp gestoppt"
  else
    say "Basecamp lief nicht"
  fi
  rm -f "$RUN/server.pid"
  if alive ollama; then
    kill "$(cat "$RUN/ollama.pid")" && say "Ollama gestoppt"
  fi
  rm -f "$RUN/ollama.pid"
}

cmd_status() {
  need_venv
  if ! server_up; then
    echo "Basecamp: aus"
    ollama_up && echo "Ollama: an" || echo "Ollama: aus"
    return 0
  fi
  "$PY" -I - "$(url)" <<'EOF'
import json, sys, urllib.request
base = sys.argv[1]
s = json.load(urllib.request.urlopen(base + "/api/status"))
print(f"Basecamp:   an  ({base})")
print(f"Ollama:  {'an' if s['ollama'] else 'aus'}  · Modell: {s['model']}")
print(f"Mac:     {s['chip']} · {s['ram_gb']} GB RAM · Stufe {s['tier']}")
print(f"Inhalte: {s['books']} Quellen · {s['files']} eigene Dateien")
print(f"Platz:   {s['disk_free_gb']} GB frei")
for t in json.load(urllib.request.urlopen(base + "/api/tasks"))["tasks"]:
    if t["status"] in ("queued", "running", "error"):
        p = f"{t['done'] / t['total'] * 100:.0f} %" if t["total"] else ""
        print(f"  ↓ {t['title']}: {t['status']} {p} {t['error']}")
EOF
}

cmd_download() {
  [[ $# -gt 0 ]] || die "Was laden? z. B. ./basecamp download M  oder  ./basecamp download ifixit_de_all"
  local json
  if [[ $# -eq 1 && "$1" =~ ^[SMLX]$ ]]; then
    json="{\"profile\": \"$1\"}"
  elif [[ $# -eq 1 && "$1" == "code" ]]; then  # all coding knowledge, except the 107 GB of Stack Overflow
    json="$("$PY" -I -c 'import json,sys; items=json.load(open(sys.argv[1]))["items"]; print(json.dumps({"ids": [i["id"] for i in items if i.get("cat") == "code" and i["id"] != "stackoverflow.com_en_all"]}))' "$ROOT/catalog.json")"
  else
    json="$("$PY" -I -c 'import json,sys; print(json.dumps({"ids": sys.argv[1:]}))' "$@")"
  fi
  api_post content/download "$json"
  say "Läuft im Hintergrund. Fortschritt: ./basecamp status oder im Browser unter Verwalten."
}

cmd_models() {
  need_venv
  need_ollama
  start_ollama
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    name="$("$PY" "$ROOT/server/app.py" --default-model)"
    say "Empfohlen für deinen Mac: $name"
  fi
  "$OLLAMA" pull "$name"
}

cmd_code() {  # terminal coding agents (Claude Code, OpenCode, Codex ...) on the local model
  need_venv
  need_ollama
  start_ollama
  local tool="${1:-claude}"; [[ $# -gt 0 ]] && shift
  local model=""
  if [[ "${1:-}" == "--model" ]]; then model="${2:-}"; shift 2; fi
  [[ -n "$model" ]] || model="$("$PY" "$ROOT/server/app.py" --code-model)"
  if ! "$OLLAMA" show "$model" >/dev/null 2>&1; then
    warn "Modell $model ist noch nicht geladen."
    read -r -p "Jetzt laden? [j/N] " yn
    [[ "$yn" =~ ^[jJyY] ]] || die "Abgebrochen. Laden mit: ./basecamp models $model"
    "$OLLAMA" pull "$model"
  fi
  if [[ "$tool" == "claude" ]]; then  # the library comes along, without any setup and on a stick too
    [[ "${1:-}" == "--" ]] && shift
    set -- -- "$@" --mcp-config "$(mcp_config)" --allowedTools mcp__basecamp
  fi
  say "Starte $tool mit $model (läuft komplett lokal)"
  exec "$OLLAMA" launch "$tool" --model "$model" "$@"
}

mcp_config() {
  "$PY" -I -c 'import json,sys; print(json.dumps({"mcpServers": {"basecamp": {"command": sys.argv[1], "args": ["mcp", "serve"]}}}))' "$ROOT/basecamp"
}

offer_mcp() {  # one skippable question, only with Claude Code on this Mac and only once
  command -v claude >/dev/null && [[ -t 0 ]] || return 0
  claude mcp get basecamp >/dev/null 2>&1 && return 0
  local yn
  read -r -p "Deine Bibliothek auch in Claude Code nutzen? [J/n] " yn
  if [[ "$yn" =~ ^[nN] ]]; then
    echo "Geht später mit: ./basecamp mcp add"
  else
    cmd_mcp add
  fi
  echo
}

cmd_mcp() {  # the library as an MCP server for coding agents. No port, no network, read only.
  case "${1:-}" in
    serve)
      need_venv
      exec "$PY" "$ROOT/server/mcp_server.py"
      ;;
    add)
      need_venv
      command -v claude >/dev/null || die "Claude Code nicht gefunden."
      claude mcp remove --scope user basecamp >/dev/null 2>&1 || true
      claude mcp add --scope user basecamp -- "$ROOT/basecamp" mcp serve
      say "Claude Code kann jetzt in jedem Projekt in deiner Bibliothek suchen. Gilt ab der nächsten Sitzung."
      ;;
    remove)
      command -v claude >/dev/null || die "Claude Code nicht gefunden."
      claude mcp remove --scope user basecamp
      ;;
    "")
      need_venv
      cat <<EOF
Coding-Agents können deine Bibliothek durchsuchen und lesen. Nur lesen, ohne Netz und ohne offenen Port.

  ./basecamp mcp add       Für Claude Code einrichten, in jedem Projekt
  ./basecamp mcp remove    Wieder entfernen
  ./basecamp download code Alle Programmier-Quellen laden, außer Stack Overflow

./basecamp code bringt die Bibliothek bei Claude Code von selbst mit.

Andere Agents (OpenCode, Codex ...) tragen das in ihre MCP-Einstellungen ein:
$(mcp_config)
EOF
      ;;
    *) die "Unbekannt: $1. Möglich: add, remove, serve" ;;
  esac
}

cmd_update() {
  api_post catalog/refresh '{}' >/dev/null
  api_post content/update '{}'
  say "Updates laufen im Hintergrund."
}

cmd_autostart() {
  case "${1:-}" in
    on)
      need_venv
      mkdir -p "$(dirname "$PLIST")"
      cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>app.basecamp.server</string>
  <key>ProgramArguments</key><array><string>$ROOT/basecamp</string><string>run</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>$RUN/server.log</string>
  <key>StandardErrorPath</key><string>$RUN/server.log</string>
</dict>
</plist>
EOF
      cmd_stop >/dev/null || true
      launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
      launchctl bootstrap "gui/$(id -u)" "$PLIST"
      say "Autostart an. Basecamp startet jetzt und bei jeder Anmeldung."
      ;;
    off)
      launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
      rm -f "$PLIST"
      say "Autostart aus."
      ;;
    *) die "./basecamp autostart on|off" ;;
  esac
}

cmd_help() {
  cat <<EOF
Basecamp: Offline-Wissen und lokale KI für den Mac

  ./basecamp setup [--data PFAD]   Einrichten (PFAD z. B. externe SSD)
  ./basecamp start [--lan]         Starten und Browser öffnen (--lan: auch fürs WLAN)
  ./basecamp stop                  Stoppen
  ./basecamp status                Zustand und Downloads
  ./basecamp open                  Browser öffnen
  ./basecamp models [NAME]         KI-Modell laden (ohne NAME: Empfehlung für diesen Mac)
  ./basecamp download S|M|L|X      Inhaltspaket laden (Klein, Mittel, Groß, Maximal)
  ./basecamp download code         Alle Programmier-Quellen laden, außer Stack Overflow
  ./basecamp download ID ...       Einzelne Quellen laden, z. B. ifixit_de_all oder map_de
  ./basecamp usb /Volumes/STICK  Alles auf einen Stick packen: App, KI und Wissen, läuft auf jedem Mac
  ./basecamp code [claude|opencode|codex|qwen] [--model NAME]
                                Coding-Agent im Terminal mit lokalem Modell
  ./basecamp mcp [add|remove]      Deine Bibliothek für Claude Code und andere Agents
  ./basecamp update                Neue Versionen der Inhalte laden
  ./basecamp autostart on|off      Beim Anmelden automatisch starten
  ./basecamp logs                  Logs ansehen
EOF
}

case "${1:-help}" in
  setup)     shift; cmd_setup "$@" ;;
  start)     shift; cmd_start "$@" ;;
  run)       shift; cmd_run "$@" ;;
  stop)      cmd_stop ;;
  restart)   shift
             if alive server; then kill "$(cat "$RUN/server.pid")"
             else pid="$(lsof -tiTCP:"$(port)" -sTCP:LISTEN 2>/dev/null | head -1 || true)"; [[ -n "$pid" ]] && kill "$pid"; fi
             rm -f "$RUN/server.pid"; for _ in $(seq 1 20); do server_up || break; sleep 0.25; done; cmd_start "$@" ;;
  status)    cmd_status ;;
  open)      open "$(url)" ;;
  download)  shift; cmd_download "$@" ;;
  models)    shift; cmd_models "$@" ;;
  usb)       shift; need_venv; exec "$PY" "$ROOT/server/usb.py" "$@" ;;
  code)      shift; cmd_code "$@" ;;
  mcp)       shift; cmd_mcp "$@" ;;
  update)    cmd_update ;;
  autostart) shift; cmd_autostart "$@" ;;
  logs)      tail -n 50 -f "$RUN/server.log" "$RUN/ollama.log" 2>/dev/null ;;
  *)         cmd_help ;;
esac
